# Line endings: shell/systemd/config files must be LF on the Pi even when edited on Windows.
* text=auto
*.sh    text eol=lf
*.tmpl  text eol=lf
*.conf  text eol=lf
*.py    text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.ps1   text eol=crlf
*.jpg   binary
*.jpeg  binary
*.png   binary
*.db    binary
*.woff2 binary
