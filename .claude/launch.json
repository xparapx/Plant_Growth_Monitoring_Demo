{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-Command", "$env:PLANT_FAKE_HW='1'; uv run plantsvc serve --host 127.0.0.1 --port 8080"],
      "port": 8080
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev", "--", "--host", "127.0.0.1"],
      "port": 5173
    }
  ]
}
